# The India Frames Backend - Environment Variables

# Environment
ENVIRONMENT=development
PROJECT_NAME="The India Frames API"
VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas Database URI (PyMongo Async)
MONGODB_URI=
MONGODB_DB_NAME=the_india_frames

# Session & Security
SESSION_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Google Identity Services (Phase 3+)
GOOGLE_CLIENT_ID=your-google-web-client-id-placeholder

# Pluggable Object Storage ("local" for dev / Railway Volume, "r2" for Cloudflare R2 Free Tier)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_ROOT=uploads
PUBLIC_API_BASE_URL=http://localhost:8000

# Cloudflare R2 (10 GB free/month, $0 egress — set STORAGE_PROVIDER=r2 in production)
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=tif-public
R2_PUBLIC_BASE_URL=https://media.theindiaframes.com
R2_PRIVATE_BUCKET=tif-private
