# The India Frames Backend - Environment Variables

# Environment
ENVIRONMENT=development
PROJECT_NAME="The India Frames API"
VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas Database URI (PyMongo Async)
MONGODB_URI=
MONGODB_DB_NAME=the_india_frames

# Session & Security
SESSION_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Google Identity Services (Phase 3+)
GOOGLE_CLIENT_ID=your-google-web-client-id-placeholder

# Cloudinary (Phase 2+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
